# 依赖
node_modules/

# 构建产物
dist/
build/

# Wrangler 本地状态（本地 D1 数据、缓存、账号信息）
.wrangler/

# 本地环境变量与密钥 —— 绝不入库
.env
.env.*
!.env.example
.dev.vars
!.dev.vars.example

# 日志与系统文件
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# 编辑器
.idea/
.vscode/*
!.vscode/extensions.json

# 临时与调试产物
coverage/
*.tsbuildinfo
.tmp/

# QuickJS 的 WASM 由 scripts/copy-quickjs-wasm.mjs 从 node_modules 复制到 src/engine/，
# 是派生产物，不入库（二进制、体积大，且版本必须跟着 quickjs-emscripten 走）。
# package.json 的 predev / prebuild / predeploy / pretest 会自动重新生成。
src/**/*.wasm
src/**/*.wasm.map.txt

# 注意：worker-configuration.d.ts 由 `npm run types` 生成，但**要提交**。
# 提交它才能在 CI（不跑 wrangler 的机器）上通过类型检查，也才能让
# 「绑定改了但类型没重新生成」这种漂移在 diff 里看得见。
