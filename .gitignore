# 依赖
node_modules/

# 构建产物
dist/
build/
# 自建（Node）那份产物 —— 由 `npm run build:node` 生成，不入库
dist-node/
# 页面（Pages）那一份要上传的目录 —— 由 `npm run build:pages` 拼出来（`public/` + Pages 的两个约定文件）
dist-pages/
# 自建模式默认落在这里的 SQLite 与它的 WAL 文件。
# **必须写成 /data/ 而不是 data/** —— 后者会连 `src/data/`（数据层源码）一起忽略，
# 于是那个目录里**新建**的文件会被静默吞掉（已跟踪的不受影响，所以这坑很难自己露头）。
/data/

# Wrangler 本地状态（本地 D1 数据、缓存、账号信息）
.wrangler/

# 本地环境变量与密钥 —— 绝不入库
.env
.env.*
!.env.example
.dev.vars
!.dev.vars.example

# 日志与系统文件
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# 编辑器
.idea/
.vscode/*
!.vscode/extensions.json

# 临时与调试产物
coverage/
*.tsbuildinfo
.tmp/

# 全量验证用的本地素材与报告 —— **绝不入库**。
#
# 这几个文件里装的是第三方书源定义（`live-*-dump.json`，几 MB）与探测报告。
# 书源是使用者自己的选择，不进仓库（见 README「关于书源」）；
# 报告则是「某一时刻线上有哪几条源能跑」的快照，会过期、也没有复现价值。
# 本地的 scripts/probe-*.mjs 默认从这些文件读，因此在本地保留、只做忽略。
live-*-dump.json
explore-report*.txt
dev-server.log

# QuickJS 的 WASM 由 scripts/copy-quickjs-wasm.mjs 从 node_modules 复制到 src/engine/，
# 是派生产物，不入库（二进制、体积约 1 MB，且版本必须跟着 quickjs-emscripten 走）。
# package.json 的 predev / prebuild / predeploy / pretest 会自动重新生成。
src/engine/*.wasm
src/engine/*.wasm.map.txt

# 注意：worker-configuration.d.ts 由 `npm run types` 生成，但**要提交**。
# 提交它才能在 CI（不跑 wrangler 的机器）上通过类型检查，也才能让
# 「绑定改了但类型没重新生成」这种漂移在 diff 里看得见。
