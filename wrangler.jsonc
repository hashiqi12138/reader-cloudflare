{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "reader-api",
    "main": "src/index.ts",
    "compatibility_date": "2026-10-01",
    "compatibility_flags": ["nodejs_compat"],
    // 这里**不能**写 `limits.cpu_ms`：本账号是 Workers 免费计划，部署会直接失败
    // （`CPU limits are not supported for the Free plan`，code 100328），
    // 免费计划的 CPU 上限是硬性的 10 ms/请求，改不了。
    // 一次搜索要把**全部**书源的规则求值塞进同一个请求，线上实测被掐断
    // （日志：`outcome: exceededCpu` / `Worker exceeded CPU time limit.`，
    // 浏览器拿到 503），而其他接口只处理一个源，所以只有搜索会挂。
    // 出路三条：升到付费计划（CPU 可提到 5 分钟）、把搜索拆成多个小请求、
    // 或只搜用户选中的书源。注意本地 wrangler dev 不设 CPU 限制，
    // 所以这个问题只在线上出现。
    "observability": {
        "enabled": true,
    },
    "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        // 必须显式声明：默认是「先查静态资源、匹配不到才进 Worker」，
        // 而 SPA 回退会把所有未命中的路径都当页面喂回 index.html，
        // 结果就是 /api/* 永远进不到 Worker。这里把接口与测试站点提出来先走 Worker。
        "run_worker_first": ["/api/*", "/fixture/*"],
    },
    "vars": {
        "ENGINE_VERSION": "0.31.0",
        // 内置测试站点默认关闭，只在本地与 CI 打开
        "ENABLE_FIXTURE": "false",
    },
    // 书源、书架、阅读进度都落在这里。本地 wrangler dev 会自动用一份
    // 独立的 SQLite，不碰线上数据；迁移用 `npm run db:migrate` 应用。
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "reader-cloudflare",
            "database_id": "387dee07-a35b-4a1c-b0f4-f447bfcae01a",
            "migrations_dir": "migrations",
        },
    ],
}
